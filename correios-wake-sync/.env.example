# ─── BLING (fonte dos pedidos e rastreios) ────────────────────────────────────
# 1. Acesse: https://developer.bling.com.br
# 2. Crie um app e copie Client ID e Client Secret
# 3. Faça a autorização OAuth2 inicial e salve o refresh_token aqui
#
BLING_API_URL=https://api.bling.com.br/Api/v3
BLING_CLIENT_ID=seu_client_id_aqui
BLING_CLIENT_SECRET=seu_client_secret_aqui
BLING_REFRESH_TOKEN=seu_refresh_token_aqui

# IDs de situação do Bling a verificar nos Correios
# Confirme em: Bling → Configurações → Situações de Pedido
# Exemplos comuns: 9=Em andamento, 12=Atendido, 15=Em aberto
BLING_SITUACOES_VERIFICAR=9,12,15

# ID da situação "Entregue" no Bling (verifique no painel)
BLING_SITUACAO_ENTREGUE_ID=

# Máximo de pedidos processados por execução
BLING_MAX_PEDIDOS=200


# ─── WAKE COMMERCE (recebe apenas a atualização de status) ────────────────────
# Painel Wake → Configurações → Integrações → API
#
WAKE_API_URL=https://api.wake.tech/graphql
WAKE_ACCESS_TOKEN=seu_token_wake_aqui

# Nome exato do status "Entregue" na Wake (confirme no painel)
WAKE_STATUS_ENTREGUE=Entregue


# ─── CORREIOS — API RASTRO ────────────────────────────────────────────────────
# Requer contrato com os Correios habilitado para a API Rastro.
# Solicite em: correios.com.br → Acesso para Empresas
#
CORREIOS_API_URL=https://api.correios.com.br
CORREIOS_USUARIO=seu_cnpj_ou_usuario_aqui
CORREIOS_SENHA=sua_senha_correios_aqui
CORREIOS_CARTAO_POSTAGEM=numero_do_cartao_postagem


# ─── CONTROLE DE EXECUÇÃO ─────────────────────────────────────────────────────
# DRY_RUN=true  → simulação: lista o que seria feito, não altera nada
# DRY_RUN=false → produção: atualiza Bling e Wake
DRY_RUN=true

# Intervalo entre pedidos em milissegundos (evita rate limit)
INTERVALO_ENTRE_PEDIDOS_MS=1500
INTERVALO_CORREIOS_MS=800

# Máximo de tentativas por requisição em caso de erro temporário
MAX_TENTATIVAS=3
