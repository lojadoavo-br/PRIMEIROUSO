# ─── WAKE COMMERCE ──────────────────────────────────────────────────────────
# Onde encontrar: Painel Wake → Configurações → Integrações → API
# A URL do GraphQL pode variar — confirme no painel da sua loja
WAKE_API_URL=https://api.wake.tech/graphql
WAKE_ACCESS_TOKEN=seu_token_wake_aqui

# Status de pedidos na Wake que devem ser verificados (exatos, separados por vírgula)
# Valores padrão para Wake Commerce em português:
WAKE_STATUS_VERIFICAR=Enviado,Em transporte,Objeto postado

# Status que a Wake usa para "Entregue" — confirme no painel
WAKE_STATUS_ENTREGUE=Entregue

# IDs numéricos alternativos (use se sua Wake trabalha com IDs de status)
# Deixe em branco para usar os nomes acima
# WAKE_STATUS_ID_VERIFICAR=3,4,5
# WAKE_STATUS_ID_ENTREGUE=6

# Número máximo de pedidos por execução (segurança)
WAKE_MAX_PEDIDOS=200


# ─── CORREIOS — API RASTRO ───────────────────────────────────────────────────
# Credenciais do contrato dos Correios
# Onde obter: correios.com.br → Acesso para Empresas → Rastro
CORREIOS_API_URL=https://api.correios.com.br
CORREIOS_USUARIO=seu_cnpj_ou_usuario_aqui
CORREIOS_SENHA=sua_senha_correios_aqui
CORREIOS_CARTAO_POSTAGEM=numero_do_cartao_postagem


# ─── CONTROLE DE EXECUÇÃO ────────────────────────────────────────────────────
# DRY_RUN=true  → Modo simulação: lista o que seria feito, não altera nada na Wake
# DRY_RUN=false → Modo produção: atualiza os pedidos na Wake
DRY_RUN=true

# Intervalo em milissegundos entre chamadas às APIs (evita bloqueio por rate limit)
INTERVALO_ENTRE_PEDIDOS_MS=1500
INTERVALO_CORREIOS_MS=800

# Máximo de tentativas em caso de erro temporário de API
MAX_TENTATIVAS=3
