# ─── CHATCENTER API (disparo WhatsApp pós-venda) ─────────────────────────────
# Onde encontrar: app.chatcenter.com.br → Configurações → Integrações → API

CHATCENTER_API_URL=https://api-br.chatcenter.com.br
CHATCENTER_API_KEY=68d54d4299d4485110508993
CHATCENTER_CHANNEL_ID=

# ─── INSTAGRAM GRAPH API (boas-vindas a novos seguidores) ────────────────────
# Onde encontrar: developers.facebook.com → Seu App → Ferramentas da API do Graph
# Permissão necessária: instagram_manage_messages

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ─── CONFIGURAÇÕES GERAIS ────────────────────────────────────────────────────
# Intervalo entre mensagens em segundos (mínimo recomendado: 6s WhatsApp / 10s Instagram)
INTERVALO_SEGUNDOS=10

# DRY_RUN=true  → simula o envio sem realmente disparar (use para testar)
# DRY_RUN=false → envia de verdade
DRY_RUN=true
