# ─── CHATCENTER API ──────────────────────────────────────────────────────────
# Onde encontrar: app.chatcenter.com.br → Configurações → Integrações → API

CHATCENTER_API_URL=https://api-br.chatcenter.com.br
CHATCENTER_API_KEY=68d54d4299d4485110508993
CHATCENTER_CHANNEL_ID=

# ─── CONFIGURAÇÕES DO DISPARO WHATSAPP ───────────────────────────────────────
# Intervalo entre mensagens em segundos (mínimo recomendado: 6s)
INTERVALO_SEGUNDOS=8

# DRY_RUN=true  → simula o envio sem realmente disparar (use para testar)
# DRY_RUN=false → envia de verdade
DRY_RUN=true


# ═══════════════════════════════════════════════════════════════════════════════
# ─── INSTAGRAM DM — LOJA DO AVÔ ──────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════════

# Credenciais da conta Instagram da Loja do Avô
INSTAGRAM_USER=lojadoavo
INSTAGRAM_PASS=sua_senha_aqui

# Modo de operação:
#   disparo   → envia mensagens para seguidores
#   respostas → escuta DMs recebidas e responde automaticamente
MODO=disparo

# Arquivo JSON com a lista de seguidores (gerado pelo exportar_seguidores.py)
ARQUIVO_SEGUIDORES=seguidores.json

# ─── LIMITES DE SEGURANÇA ────────────────────────────────────────────────────
# Máximo de mensagens por sessão (recomendado: 30–50 por dia)
LIMITE_POR_SESSAO=40

# Intervalo entre mensagens (segundos) — NUNCA coloque abaixo de 45s
INTERVALO_MIN=60
INTERVALO_MAX=180

# Pausa longa a cada N mensagens enviadas (simula comportamento humano)
PAUSA_LONGA_A_CADA=10
PAUSA_LONGA_MIN=300
PAUSA_LONGA_MAX=600
